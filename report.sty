from geojson import Point as GeoJSONPoint, Feature, FeatureCollection
from folium.plugins import HeatMap  

#2018
# Loading overdose death data for 2018
overdose_data = pd.read_csv("C:/Users/ecrin/Downloads/NC_2018_mortality_data.txt", sep="\t")
overdose_data = overdose_data.dropna(subset=["County Code"])
overdose_data["County Code"] = overdose_data["County Code"].astype(float).astype(int).astype(str).str.zfill(5)
overdose_data.columns = overdose_data.columns.str.strip()

# Loading county shapefiles for NC
counties = pygris.counties(state="NC", year=2023, cache=True)
counties = gpd.GeoDataFrame(counties)
counties["centroid"] = counties.geometry.centroid 
counties["lat"] = counties["centroid"].apply(lambda point: point.y) 
counties["lon"] = counties["centroid"].apply(lambda point: point.x)

# Merge overdose data with counties
merged_data = overdose_data.merge(counties[['GEOID', 'lat', 'lon']], 
                                  left_on='County Code', right_on='GEOID', 
                                  how='left')
merged_data = merged_data.dropna(subset=['lat', 'lon'])
merged_data["Crude Rate"] = pd.to_numeric(merged_data["Crude Rate"], errors="coerce")


# Load NC primary roads
roads = pygris.primary_secondary_roads(state="NC", year=2023, cache=True)
primary_roads = roads[roads["MTFCC"] == "S1100"] 

# Create folium map
m = folium.Map(location=[35.25, -80], zoom_start=7)

# Add primary roads to map
folium.GeoJson(primary_roads, name="Primary Roads", 
               style_function=lambda x: {"color": "blue", "weight": 1}).add_to(m)

counties = counties.to_crs(epsg=4326)
counties_geojson = counties.drop(columns=["centroid"], errors="ignore").to_json() 


# Add county boundaries to the map
folium.GeoJson(counties_geojson, 
               name="County Boundaries", 
               style_function=lambda x: {"fillOpacity": 0, "color": "black", 
               "weight": 0.5}).add_to(m)

# Add heatmap layer for overdose data
heat_data = [
    [row["lat"], row["lon"], row["Crude Rate"]]
    for _, row in merged_data.iterrows()
    if not pd.isna(row["Crude Rate"]) 
]
HeatMap(heat_data, min_opacity=0.2, max_val=max(merged_data["Crude Rate"]), 
radius=25, blur=15).add_to(m)

# Add layer control
folium.LayerControl().add_to(m)

# Display map
m
