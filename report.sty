MSE4 = mean_squared_error(y_test, y_pred)
RMS4 = np.sqrt(MSE4)
print('root MSE (p=4):', RMS4)

#model for p=8
poly = PolynomialFeatures(degree = 8)
X_poly = poly.fit_transform(X)
model8 = model.fit(X_poly, y)

coefficients = model8.coef_  
intercept = model8.intercept_  
feature_names = poly.get_feature_names_out(input_features=['x1', 'x2', 'x3', 'x4', 'x5'])
model_terms = [f"({coefficients[i]:.5f}){feature_names[i]}" for i in range(len(coefficients))]
model_equation = f"{intercept:.5f} + " + " + ".join(model_terms[1:]) 
print(f"Model for p=8: {model_equation}")

#error for p=8
X_test_poly = poly.fit_transform(X_test)
y_pred = model8.predict(X_test_poly)
